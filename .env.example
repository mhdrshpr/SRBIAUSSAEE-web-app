# ==============================================
# SSAEE Panel v2 - تنظیمات محیطی
# این فایل را به .env تغییر نام دهید
# ==============================================

APP_ENV=production
APP_DEBUG=0
APP_URL=https://your-domain.example.com
APP_TIMEZONE=Asia/Tehran

DB_HOST=localhost
DB_PORT=3306
DB_NAME=your_db_name
DB_USER=your_db_user
DB_PASS=your_db_password

# حداقل ۴۸ کاراکتر تصادفی (bin2hex(random_bytes(32)))
JWT_SECRET=
APP_SECRET=

TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_BOT_USERNAME=

SESSION_NAME=SSAEE_SESSION
COOKIE_SECURE=1
COOKIE_HTTPONLY=1

RATE_LIMIT_ENABLED=1
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15

CRON_SECRET=change_me_random_secret
ADMIN_2FA_ENABLED=1
ADMIN_2FA_TTL=300

# ---------- Certificate PDF renderer (Browserless) ----------
CERT_PDF_PROVIDER=browserless
CERT_PDF_ENDPOINT=https://production-sfo.browserless.io/pdf
CERT_PDF_API_KEY=
CERT_PDF_TOKEN=
CERT_PDF_TIMEOUT=30
CERT_PDF_CONNECT_TIMEOUT=5
CERT_PDF_CACHE_ENABLED=true
CERT_PDF_CACHE_DIR=
CERT_PDF_RENDER_VERSION=1
CERT_PDF_TEMPLATE_VERSION=1

# Generic self-hosted service contract (CERT_PDF_PROVIDER=raw):
#   CERT_PDF_ENDPOINT=https://pdf.yourdomain.example/render
#   CERT_PDF_TOKEN=<bearer for your tools/pdf-service>
