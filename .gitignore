# ============================================================
# SSAEE Panel v2 — Git Ignore Configuration
# Protects sensitive secrets, database credentials, logs, and artifacts
# ============================================================

# Environment variables & secrets (CRITICAL)
.env
.env.*
.env.local
.env.production
.env.staging
!.env.example

# Database dumps & SQL files
*.sql
*.sqlite
*.db

# Backups & archives
storage/backups/*
!storage/backups/.gitkeep
*.zip
*.tar
*.tar.gz
*.tgz
*.rar
*.7z
*.bak
*.backup
*.old
*.dist

# Runtime logs & cache
storage/logs/*
!storage/logs/.gitkeep
storage/cache/*
!storage/cache/.gitkeep
*.log

# Generated certificate artifacts & uploads
storage/certificates/*
!storage/certificates/.gitkeep
!storage/certificates/.htaccess
storage/uploads/*
!storage/uploads/.gitkeep

# Node.js dependencies (for pdf-service)
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
package-lock.json

# Operating System & IDE artifacts
.DS_Store
Thumbs.db
ehthumbs.db
desktop.ini
.idea/
.vscode/
*.sublime-project
*.sublime-workspace
.gemini/
__pycache__/
*.py[cod]
*$py.class

# Diagnostic & temporary scripts
diag.php
promote.php
appbeta.html
patcher.py
